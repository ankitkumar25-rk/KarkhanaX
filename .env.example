# Server & Environment Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (PostgreSQL & Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karkhanax?schema=public"

# Redis / Valkey Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# PASETO Authentication (32-byte Hex Key)
# Generate using: npx tsx scripts/generate-keys.ts
PASETO_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PASETO_ISSUER=karkhanax-api
PASETO_AUDIENCE=karkhanax-app

# Google OAuth 2.0 Social Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary CDN Media Storage (Products & Banners)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Transactional Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=KarkhanaX <no-reply@karkhanax.com>

# Geospatial & Address Validation (Google Maps)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

