// This is the Prisma schema file for KarkhanaX
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// ENUMS
// ================================

enum Role {
  CUSTOMER
  ADMIN
}

// ================================
// USER & AUTH
// ================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String?
  role            Role      @default(CUSTOMER)
  isVerified      Boolean   @default(false)
  avatarUrl       String?
  googleId        String?   @unique
  isBanned        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  addresses       Address[]

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  isDefault   Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}
